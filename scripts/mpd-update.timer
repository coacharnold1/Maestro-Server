[Unit]
Description=Run MPD Database Update Twice Daily

[Timer]
# Refresh the database at 04:00 and 16:00. Scans walk the whole music library
# (often over NFS), so frequent runs add significant load.
OnCalendar=*-*-* 04,16:00:00
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
